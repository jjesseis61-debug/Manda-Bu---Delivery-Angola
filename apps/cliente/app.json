{
  "expo": {
    "name": "Manda Bué",
    "slug": "manda-bue-delivery-angola",
    "owner": "domundo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ao.mandabue.cliente"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B5121B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ao.mandabue.cliente",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B5121B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A Manda Bué usa a tua localização para marcar o ponto de entrega no mapa."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Manda Bué usa as tuas fotos só para as juntares às avaliações que escreves.",
          "cameraPermission": false
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "scheme": "mandabue",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f237075d-ebf8-43e4-b0f4-24d302f975a8"
      }
    }
  }
}
