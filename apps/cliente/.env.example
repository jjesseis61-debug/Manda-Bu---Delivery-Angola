# Copiar para .env (não vai para o repositório) e preencher com os valores do projecto Supabase.
# São valores públicos da app (URL e chave publicável); nunca colocar aqui a chave secreta / service_role.
EXPO_PUBLIC_SUPABASE_URL=https://laruvuambdovnkojwrzp.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Contacto mostrado na política de privacidade (email ou telefone). Obrigatório antes de publicar nas lojas.
EXPO_PUBLIC_CONTACTO_PRIVACIDADE=
# Chave do Google Maps SDK for Android (mapa do ecrã "Novo endereço"). Sem ela o mapa fica em branco em Android.
GOOGLE_MAPS_ANDROID_API_KEY=
